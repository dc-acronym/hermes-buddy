{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hermes Buddy",
  "version": "0.2.1",
  "identifier": "dev.hermes-buddy.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hermes Buddy",
        "width": 330,
        "height": 640,
        "resizable": true,
        "decorations": false,
        "maximizable": false,
        "alwaysOnTop": true,
        "acceptFirstMouse": true,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": false,
        "dragDropEnabled": true,
        "minWidth": 132,
        "minHeight": 132
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
